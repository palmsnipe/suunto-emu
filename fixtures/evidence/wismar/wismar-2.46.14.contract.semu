[timer14]
transaction=32-bit control write at 0x40008000+0x3c0 with value 0x00000a10 (function-select bits 4..7 = Edge=1)
lane_behavior=WISMAR_TIMER14_EDGE_COMPAT value=0x00000A10 mode=upcount; the Wismar-local wrapper maps Edge(1) to Upcount(2) for this exact selector only
observed_first=display-boundary probe at virtual_ticks ~0.1598 s (first WISMAR_TIMER14_EDGE_COMPAT line); 30 hits in the 1 s BKPT probe and 13 in each 2 s display/svc probe
source=$FIRMWARE_ROOT/emulator/devices/wismar/WismarApollo4Timer.cs (SHA-256 0aa513f421c6812a06956456fd69bc1b5b01e2deba10709464c08f467fee61c1)
classification=first Wismar-specific transaction that the shared upstream Apollo4 timer model rejects; the lane-local wrapper is the workaround, not a firmware fact

[mspi2]
transaction=instruction=0x009f0000, address=0x00000000, count=3, response=20 bb 19
observed_first=MSPI2 RX DMA at virtual_ticks=159800000 (display-boundary probe); 4 hits in each 2 s display/svc probe and 9 in the 1 s BKPT probe
source=$FIRMWARE_ROOT/emulator/renode/mspi2/SapporoApollo4Mspi2.cs (shared model; ReadIdCommand=0x9f; MicronId 20 bb 19)
note=the identity 20 bb 19 is shared with the Sapporo model; Wismar's use of JEDEC 0x9f is observed in the lane log


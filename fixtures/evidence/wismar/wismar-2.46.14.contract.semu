[first_unsupported]
transaction=Timer14 edge-mode control write, value 0x00000a10 at 0x40008000+0x3c0; the shared upstream Apollo4 timer model rejects this selector and the lane-local wrapper maps it to upcount; this is the first Wismar-specific transaction requiring non-shared behavior
execution_boundary=UsageFault UNDEFINSTR CFSR 0x00010000 at stacked PC 0x00534900, LR 0x0051079d, fault entry PC 0x697e96; observed twice in the 2 s display and svc-translator probes; classified as a Renode 1.16 translator artifact (the bytes at 0x00534900 are a valid Thumb-2 literal-load sequence), not a Wismar firmware contract
display_submission=not reached before the UNDEFINSTR boundary; no display stream or frame hash exists
preceding_lane_model_gaps=gpio unhandled writes (offsets 0x400/0x340), non-existing peripheral writes at 0x40010470/0x40010464/0x4001045c, and CLKGEN reads at 0x4000400c/0x40004044; these are lane model absences that log warnings and do not stop execution

[display_contract]
status=unknown
reason=no DIAP/MSPI1 display submission was observed; the 2 s display-boundary probe faults at 0x00534900 before any submission; no Wismar display stream, framebuffer, PNG or frame hash exists anywhere in the evidence root
next=read-only trace of the first display-driver request after the translator boundary is resolved; no synthetic panel pixels


[bounded_traces]
status=observed
lane=$FIRMWARE_ROOT/emulator/devices/ulsan/run-2.35.36-smoke.sh
 (ulsan-2.35.36-boundary.resc)
reset_trace_sha256=f1bf0a8e58037c78cd2f890fed989540d5881fdbbe44ce894d18807d081e20a8
trace_pair=two fresh runs, normalized keep-set streams byte-identical;
 raw logs differed only in Renode banner lines and one extra
 "MAX17050 read reg 0x21" diagnostic line in run 1, outside the keep-set
startup_stop=paused after ulsan-2.35.36-boundary.resc; pc=0xdabcc
terminal_registers=order PC SP LR CFSR HFSR then display/MSPI slots per the
 boundary resc: 0xdabcc 0x10029e40 0x9760b 0x00000000 0x00000000 0x87452365
 0x00000000 0x00000000 0x00000000 0x00000000 0x10033fb0 0x00000001
fault_registers=CFSR=0x00000000 HFSR=0x00000000
display_identity=IDREG 0x87452365 observed at boundary; display-control slot
 (0x400a00f8) read 0x00000000 at the pause
mspi1_slot_values=inten/intstat/control 0x00000000 each, address 0x10033fb0,
 count 0x00000001
pmic_i2c=IOM I2C@0x28 write/read sequence captured in normalized trace
external_flash_identity=JEDEC C2 25 39 (Macronix MX25U25645G) observed in log
lane_caveat=the reference wrapper's own assertions are stale against its
 current model: it expects display-control 0x10 and an "MSPI command queue
 retired: control=0x00000013" log line that the model no longer emits
 (it logs native JEDEC-identity and payload-free PIO wording instead),
 so the script exits 1 while producing the deterministic pause above;
 this contract records the observed terminal state, not the script's
 expectations


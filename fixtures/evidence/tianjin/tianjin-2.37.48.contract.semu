[start_tuple]
status=unknown
reason=three components carry a vector table and the manifest load fields are not mutually consistent as runtime addresses (components 02, 04 and 05 all report 0x00040000, component 03 reports 0x00019000), so no CPU start tuple, vector-table base, or runtime placement is derived from the package alone

[format_ambiguities]
header_fields=bytes 0x04 (0x0b462834, equal to the filename suffix) and 0x08 (0x00a9e0b6, equal to size minus 12) are observed; their semantics are not proven from the bytes
record_tail=bytes 0x1c..0x2f of each 0x30-byte record are nonzero for records 02-05 and for slots 6-7; field boundaries and semantics are unproven
vector_interpretation=the first two words of components 02-04 are recorded as initial SP and reset vector by convention; the bytes establish the values only
load_overlap=components 02, 04 and 05 declare overlapping ranges at base 0x00040000; per-type load semantics are unproven

[load_layout]
manifest_load_fields=component 02 0x00040000; component 03 0x00019000; component 04 0x00040000; component 05 0x00040000
overlap=components 02, 04 and 05 share the manifest load field 0x00040000
runtime_placement=unknown
sharing_proof=none
cross_product_note=Ulsan 2.35.36 places resident type 5 at 0x00010000 and application type 4 at 0x00030000 (E-ULS-0001), so Tianjin's type-2/type-4 loads differ and Ulsan wiring cannot be reused without proof


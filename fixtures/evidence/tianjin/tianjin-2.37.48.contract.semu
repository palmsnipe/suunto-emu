[intake_outcome]
eligible=false
reason=The package, component, hash, load-field, vector and provenance contract is complete and byte-verified twice, but eligibility additionally requires an exact memory/IRQ contract, board wiring, a repeatable bounded first stop, and display/input contracts. The read-only lane lists Tianjin as cataloged with a planned profile that has no executable launcher, so no bounded trace can be captured; no Tianjin-specific memory, IRQ, board, display or input evidence exists in the lane or the research records. The manifest load fields place three components at 0x00040000, so runtime placement cannot be derived from the package alone, and the layout differs from Ulsan 2.35.36 (resident type 5 at 0x00010000, application type 4 at 0x00030000), so Ulsan wiring cannot be reused without proof.
ticket_775_may_start=false
next_step=Obtain exact Tianjin memory/IRQ/board/display/input evidence (an executable lane profile or owner-authorized offline RE of the pinned firmware) before any reset-profile work; do not manufacture placeholders

[limitations]
no_firmware_bytes=only sizes, offsets, hashes, CRCs and derived boundaries are recorded; no firmware or resource bytes enter Git
roles_not_asserted=component roles are not claimed; the extraction tool labels type numbers only
device_personalized=first 262144 bytes of external flash and device-specific state are absent and permanently unavailable without hardware; never guessed
no_inheritance=no family inheritance is inferred from the shared Apollo4 class or the identical type-1 v1 header hash
no_guest_behavior=the lane is the sole machine oracle and has no Tianjin executable profile, so no guest-visible behavior is observed or claimed
